{
  "manifest_version": 3,
  "name": "DomSeek",
  "version": "0.1.1",
  "description": "ページのリンクやボタンをキーボードで検索して実行します。",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "DomSeekを開く" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" }
    }
  }
}
